[Unit]
Description=Hivemind Replica
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=-/etc/hivemind/replica.env
ExecStart=/usr/local/bin/hivemind \
    --node-id ${HIVEMIND_NODE_ID} \
    --replica-count ${HIVEMIND_REPLICA_COUNT} \
    --worker-port ${HIVEMIND_AGENT_PORT} \
    --client-port ${HIVEMIND_CLIENT_PORT} \
    --replica-port ${HIVEMIND_PEER_PORT} \
    --peers ${HIVEMIND_PEERS} \
    --data-dir ${HIVEMIND_DATA_DIR} \
    --metrics-port ${HIVEMIND_METRICS_PORT} \
    --s3-backup ${HIVEMIND_S3_BACKUP} \
    --gossip-port ${HIVEMIND_GOSSIP_PORT} \
    --gossip-peers ${HIVEMIND_GOSSIP_PEERS} \
    --region ${HIVEMIND_REGION}
Restart=always
RestartSec=5
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=10
LimitNOFILE=65536
OOMScoreAdjust=-500
ProtectSystem=full
ReadWritePaths=/var/lib/hivemind
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
