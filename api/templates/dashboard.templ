package templates

import "fmt"

templ Dashboard() {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>Hivemind Dashboard</title>
		<script src="https://unpkg.com/htmx.org@2.0.4" integrity="sha384-HGfztofotfshcF7+8n44JQL2oJmowVChPTg48S+jvZoztPfvwD79OC/LTtG6dMp+" crossorigin="anonymous"></script>
		<style>
			* { box-sizing: border-box; margin: 0; padding: 0; }
			body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, monospace; background: #0d1117; color: #c9d1d9; padding: 24px; }
			h1 { font-size: 1.5rem; margin-bottom: 20px; color: #58a6ff; }
			h2 { font-size: 1.1rem; margin-bottom: 12px; color: #8b949e; text-transform: uppercase; letter-spacing: 0.05em; }
			.grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px; }
			.card { background: #161b22; border: 1px solid #30363d; border-radius: 8px; padding: 16px; }
			.full { grid-column: 1 / -1; }
			table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
			th { text-align: left; padding: 8px 12px; border-bottom: 1px solid #30363d; color: #8b949e; font-weight: 600; }
			td { padding: 6px 12px; border-bottom: 1px solid #21262d; }
			.stat { display: inline-block; margin-right: 24px; }
			.stat-value { font-size: 1.8rem; font-weight: 700; color: #f0f6fc; }
			.stat-label { font-size: 0.75rem; color: #8b949e; text-transform: uppercase; }
			.ok { color: #3fb950; }
			.warn { color: #d29922; }
			.err { color: #f85149; }
			.muted { color: #484f58; }
			.badge { display: inline-block; padding: 2px 8px; border-radius: 12px; font-size: 0.75rem; font-weight: 600; }
			.badge-green { background: #1b3a2d; color: #3fb950; }
			.badge-yellow { background: #3d2e00; color: #d29922; }
			.badge-red { background: #3d1418; color: #f85149; }
			.badge-gray { background: #21262d; color: #8b949e; }
			.htmx-settling { opacity: 0.8; }
			.error-banner { background: #3d1418; color: #f85149; padding: 8px 12px; border-radius: 4px; font-size: 0.85rem; margin-bottom: 8px; }
			.img-tag { font-size: 0.75rem; color: #8b949e; font-family: monospace; }
		</style>
	</head>
	<body>
		<h1>Hivemind Cluster</h1>
		<div class="grid">
			<div class="card full" hx-get="/dashboard/cluster" hx-trigger="load, every 5s" hx-swap="innerHTML"></div>
			<div class="card" hx-get="/dashboard/nodes" hx-trigger="load, every 5s" hx-swap="innerHTML"></div>
			<div class="card" hx-get="/dashboard/workers" hx-trigger="load, every 5s" hx-swap="innerHTML"></div>
			<div class="card full" hx-get="/dashboard/deployments" hx-trigger="load, every 5s" hx-swap="innerHTML"></div>
			<div class="card" hx-get="/dashboard/queue" hx-trigger="load, every 5s" hx-swap="innerHTML"></div>
			<div class="card" hx-get="/dashboard/pods" hx-trigger="load, every 5s" hx-swap="innerHTML"></div>
		</div>
		<script>
			// Show error banner when HTMX request fails
			document.body.addEventListener('htmx:responseError', function(evt) {
				evt.detail.target.innerHTML = '<div class="error-banner">Failed to load: ' +
					(evt.detail.xhr.status || 'connection error') + '</div>';
			});
		</script>
	</body>
	</html>
}

templ ClusterSection(cs *ClusterStateView) {
	<h2>Consensus</h2>
	<div>
		<div class="stat">
			<div class="stat-value">
				if cs.IsLeader {
					<span class="ok">Leader</span>
				} else {
					<span class="muted">Follower</span>
				}
			</div>
			<div class="stat-label">Role</div>
		</div>
		<div class="stat">
			<div class="stat-value">{ cs.StatusName }</div>
			<div class="stat-label">Status</div>
		</div>
		<div class="stat">
			<div class="stat-value">{ fmt.Sprint(cs.ViewNumber) }</div>
			<div class="stat-label">View</div>
		</div>
		<div class="stat">
			<div class="stat-value">{ fmt.Sprint(cs.CommitMin) }</div>
			<div class="stat-label">Committed</div>
		</div>
		<div class="stat">
			<div class="stat-value">{ fmt.Sprint(cs.OpNumber) }</div>
			<div class="stat-label">Op Number</div>
		</div>
	</div>
}

templ NodesSection(nodes []NodeView) {
	<h2>Nodes ({ fmt.Sprint(len(nodes)) })</h2>
	if len(nodes) == 0 {
		<p class="muted">No nodes registered</p>
	} else {
		<table>
			<tr><th>Name</th><th>Status</th><th>GPU</th><th>CPU</th><th>Memory</th><th>Region</th></tr>
			for _, n := range nodes {
				<tr>
					<td>{ n.Name }</td>
					<td><span class={ n.StatusClass }>{ n.StatusName }</span></td>
					<td>{ n.GpuSummary }</td>
					<td>{ n.CPUDisplay }</td>
					<td>{ n.MemDisplay }</td>
					<td>{ n.Region }</td>
				</tr>
			}
		</table>
	}
}

templ DeploymentsSection(deps []DeploymentView) {
	<h2>Deployments ({ fmt.Sprint(len(deps)) })</h2>
	if len(deps) == 0 {
		<p class="muted">No deployments</p>
	} else {
		<table>
			<tr><th>Name</th><th>Image</th><th>Replicas</th><th>Version</th><th>GPU</th><th>Status</th></tr>
			for _, d := range deps {
				<tr>
					<td>{ d.Name }</td>
					<td><span class="img-tag">{ d.Image }</span></td>
					<td>
						<span class={ d.ReplicaClass }>{ fmt.Sprint(d.ReadyReplicas) }</span>
						<span class="muted">/{ fmt.Sprint(d.Replicas) }</span>
					</td>
					<td>v{ fmt.Sprint(d.Version) }</td>
					<td>{ d.GpuSummary }</td>
					<td>
						if d.Paused {
							<span class="badge badge-yellow">Paused</span>
						} else {
							<span class="badge badge-green">Active</span>
						}
					</td>
				</tr>
			}
		</table>
	}
}

templ WorkersSection(workers []WorkerView) {
	<h2>Workers ({ fmt.Sprint(len(workers)) })</h2>
	if len(workers) == 0 {
		<p class="muted">No workers connected</p>
	} else {
		<table>
			<tr><th>Hostname</th><th>Node</th><th>Status</th><th>GPU</th><th>Heartbeat</th></tr>
			for _, a := range workers {
				<tr>
					<td>{ a.Hostname }</td>
					<td class="muted">{ fmt.Sprintf("%x", a.NodeID) }</td>
					<td>
						if a.Connected {
							<span class="badge badge-green">Connected</span>
						} else {
							<span class="badge badge-red">Disconnected</span>
						}
					</td>
					<td>{ a.GpuSummary }</td>
					<td class={ a.HeartbeatClass }>{ a.HeartbeatAge }</td>
				</tr>
			}
		</table>
	}
}

templ QueueSection(q *QueueView) {
	<h2>Request Queue</h2>
	<div>
		<div class="stat">
			<div class="stat-value">{ fmt.Sprint(q.Depth) }</div>
			<div class="stat-label">Queued</div>
		</div>
		<div class="stat">
			<div class="stat-value">{ fmt.Sprint(q.InFlight) }</div>
			<div class="stat-label">In-Flight</div>
		</div>
		<div class="stat">
			<div class="stat-value">{ fmt.Sprint(q.EnqueueTotal) }</div>
			<div class="stat-label">Enqueued (total)</div>
		</div>
		<div class="stat">
			<div class="stat-value">{ fmt.Sprint(q.DispatchTotal) }</div>
			<div class="stat-label">Dispatched</div>
		</div>
		<div class="stat">
			<div class="stat-value">{ fmt.Sprint(q.ResolveTotal) }</div>
			<div class="stat-label">Resolved</div>
		</div>
	</div>
}

templ PodsSection(pods []PodView) {
	<h2>Pods ({ fmt.Sprint(len(pods)) })</h2>
	if len(pods) == 0 {
		<p class="muted">No pods</p>
	} else {
		<table>
			<tr><th>ID</th><th>Deployment</th><th>Node</th><th>Phase</th></tr>
			for _, p := range pods {
				<tr>
					<td class="muted">{ fmt.Sprintf("%x", p.ID) }</td>
					<td class="muted">{ fmt.Sprintf("%x", p.DeploymentID) }</td>
					<td class="muted">{ fmt.Sprintf("%x", p.NodeID) }</td>
					<td><span class={ p.PhaseClass }>{ p.PhaseName }</span></td>
				</tr>
			}
		</table>
	}
}

templ ErrorSection(message string) {
	<div class="error-banner">{ message }</div>
}
