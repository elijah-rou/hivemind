.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Debug files
*.pdb
*.core
core.*
vgcore.*

# Test artifacts
test-results/
coverage/
*.prof

# VOPR traces
vopr-traces/
replay/

# Data directories
data/
logs/

# Config files (except examples)
*.conf
!example.conf

# Terraform
.terraform/
*.tfstate
*.tfstate.backup
*.tfplan

# Go binaries (never commit build outputs)
bench/bench
bench/bench-linux
bench/hivemind-bench
api/api
api/hivemind-api
