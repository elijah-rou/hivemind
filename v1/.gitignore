# POC deployment binaries
infra/poc/hivemind-linux
infra/poc/hivemind-api-linux
infra/poc/hivemind-worker-linux

# POC terraform-generated vars
infra/poc/terraform.tfvars

# POC secrets + ephemeral artifacts
infra/poc/.encryption_key
infra/poc/*.plan

# Workspace-local agent context
.context/

# Rust / Cargo
worker/target/

# Fuzz corpus (regenerated each run)
core/fuzz_failures.jsonl

# Documentation build
docs/build/

# Python cache
__pycache__/
*.py[cod]
