[Unit]
Description=Hivemind API Gateway
After=network-online.target hivemind.service
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=-/etc/hivemind/api.env
ExecStart=/usr/local/bin/hivemind-api \
    --listen ${HIVEMIND_API_LISTEN} \
    --addrs ${HIVEMIND_API_ADDRS} \
    --dns-targets ${HIVEMIND_API_DNS_TARGETS}
Restart=always
RestartSec=5
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=10
LimitNOFILE=65536
ProtectSystem=full
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
